# Pagecraft web — docs/04-technical-design.md §13. Copy to .env.local for dev.

# Where the API lives. Server components call it directly; the browser goes through the
# /api/* rewrite (next.config.ts), so cookies stay first-party.
API_URL=http://localhost:8000

# Shared with the API (same value). The API calls POST /api/revalidate with it after every
# publish, so the published page updates in about a second instead of within 60 s.
REVALIDATE_SECRET=

# The host published sites hang off: {slug}.NEXT_PUBLIC_SITE_HOST is rewritten to /s/{slug}
# (middleware.ts). Only matters once the wildcard DNS record exists.
NEXT_PUBLIC_SITE_HOST=pagecraft.virajdomadia.com

# Shared with the API (same value): proves the visitor IP this app forwards on /api/* requests.
PROXY_SECRET=
