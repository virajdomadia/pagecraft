# Pagecraft API — every v1 key from docs/04-technical-design.md §13. Copy to .env.local for dev.
# Nothing here is required to import the app or serve /health; keys arrive just-in-time per plan row.

# S2 — Neon Postgres. The URL exactly as Neon hands it out (postgresql://…?sslmode=require) works;
# app/db.py converts it for asyncpg. Vercel: production → Neon `main`, preview/dev → `dev`.
DATABASE_URL=postgresql+asyncpg://pagecraft@localhost:5432/pagecraft_dev
# Local/CI only: a throwaway database the pytest harness rebuilds through Alembic on every run.
TEST_DATABASE_URL=postgresql+asyncpg://pagecraft@localhost:5432/pagecraft_test

# Where the web app lives: the revalidate hook (POST {WEB_URL}/api/revalidate), the published
# URL the API reports, and whether the session cookie is Secure (https → yes).
WEB_URL=http://localhost:3000
# The host published sites hang off ({slug}.SITE_HOST); /s/{slug} works without wildcard DNS.
SITE_HOST=pagecraft.virajdomadia.com

# F1/F4 — shared with web (same value in both projects). Unset → publish skips the hook and
# published pages refresh within ISR's 60 s instead of ~1 s.
REVALIDATE_SECRET=

# F3 — Vercel Blob read-write token. Unset → uploads are stored in Postgres and served from
# /media/{id} (web: /api/media/{id}), so uploads work before the Blob store exists.
BLOB_READ_WRITE_TOKEN=

# L4 - email for invites and password resets, plain SMTP with STARTTLS (Gmail: smtp.gmail.com,
# 587, the Gmail address, a 16-character app password). Unset -> email is off: an invite shows its
# link to the inviting owner instead, and password resets can't be sent (never shown on screen).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Shared with web (same value). Web forwards the visitor's IP with it; the per-IP rate limits
# trust that header only when this matches. Unset → limits key on x-forwarded-for.
PROXY_SECRET=
